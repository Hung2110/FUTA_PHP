<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Đặt login.php làm trang mặc định khi truy cập vào thư mục admin -->
        <defaultDocument>
            <files>
                <clear />
                <add value="login.php" />
            </files>
        </defaultDocument>
        <security>
            <requestFiltering>
                <!-- Chặn truy cập trực tiếp vào các file nhạy cảm tương tự FilesMatch trong .htaccess -->
                <hiddenSegments>
                    <add segment="auth_check.php" />
                    <add segment="sidebar.php" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>